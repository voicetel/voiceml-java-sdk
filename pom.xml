<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.voicetel</groupId>
    <artifactId>voiceml</artifactId>
    <version>0.9.4</version>
    <packaging>jar</packaging>

    <name>VoiceML Java SDK</name>
    <description>Official Java SDK for the VoiceML REST API, a Twilio-compatible voice and messaging API.</description>
    <url>https://github.com/voicetel/voiceml-java-sdk</url>

    <licenses>
        <license>
            <name>MIT with Commons Clause</name>
            <url>https://github.com/voicetel/voiceml-java-sdk/blob/main/LICENSE</url>
            <distribution>repo</distribution>
            <comments>MIT License with the Commons Clause restriction; see the LICENSE file and https://voicetel.com/legal/.</comments>
        </license>
    </licenses>

    <organization>
        <name>VoiceTel Communications</name>
        <url>https://voicetel.com</url>
    </organization>

    <developers>
        <developer>
            <id>mavroudis</id>
            <name>Michael Mavroudis</name>
            <email>support@voicetel.com</email>
            <organization>VoiceTel Communications</organization>
            <organizationUrl>https://voicetel.com</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/voicetel/voiceml-java-sdk.git</connection>
        <developerConnection>scm:git:git@github.com:voicetel/voiceml-java-sdk.git</developerConnection>
        <url>https://github.com/voicetel/voiceml-java-sdk</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/voicetel/voiceml-java-sdk/issues</url>
    </issueManagement>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!--
            The published library targets Java 11 (`release 11`). The test suite needs
            Java 17 because JUnit 6 does; CI additionally runs a JUnit-free runtime smoke
            test of the built jar on JDK 11 (see .github/workflows/ci.yml).
        -->
        <maven.compiler.release>11</maven.compiler.release>
        <maven.compiler.testRelease>17</maven.compiler.testRelease>
        <jackson.version>2.22.3</jackson.version>
        <junit.version>6.1.3</junit.version>
        <assertj.version>3.27.7</assertj.version>
        <conformance.exclude>**/ConformanceTest.java</conformance.exclude>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Keeps jackson-core / jackson-annotations / jackson-databind aligned. -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>${project.basedir}</directory>
                <targetPath>META-INF</targetPath>
                <includes>
                    <include>LICENSE</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <testRelease>${maven.compiler.testRelease}</testRelease>
                    <showWarnings>true</showWarnings>
                    <failOnWarning>true</failOnWarning>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <systemPropertyVariables>
                        <!-- The JDK test HTTP server otherwise adds ~40 ms (Nagle) per mocked response. -->
                        <sun.net.httpserver.nodelay>true</sun.net.httpserver.nodelay>
                    </systemPropertyVariables>
                    <excludes>
                        <!--
                            Needs the private fixture corpus; runs only under the `conformance`
                            profile below, which activates when VOICEML_CONFORMANCE_FIXTURES is set.
                            The public spec is covered on every run by contract.SpecContractTest.
                        -->
                        <exclude>${conformance.exclude}</exclude>
                    </excludes>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.1</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>com.voicetel.voiceml</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.4.0</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.12.0</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <!-- Every Javadoc problem except a missing comment fails the build. -->
                    <doclint>all,-missing</doclint>
                    <failOnWarnings>true</failOnWarnings>
                    <release>${maven.compiler.release}</release>
                    <quiet>true</quiet>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Fixture-corpus conformance tests: on whenever VOICEML_CONFORMANCE_FIXTURES is set. -->
        <profile>
            <id>conformance</id>
            <activation>
                <property>
                    <name>env.VOICEML_CONFORMANCE_FIXTURES</name>
                </property>
            </activation>
            <properties>
                <conformance.exclude>none</conformance.exclude>
            </properties>
        </profile>

        <!--
            Activated by `mvn -P release deploy` (CI release workflow). Adds the
            two pieces required by Maven Central:

              maven-gpg-plugin            — detached signatures on every artifact
              central-publishing-maven-plugin — uploads to the new Central Portal
                                                (replaces the deprecated OSSRH
                                                staging flow)

            Required environment for the release run:
              CENTRAL_USERNAME            — Central Portal user token name
              CENTRAL_PASSWORD            — Central Portal user token secret
              MAVEN_GPG_PRIVATE_KEY       — ASCII-armored GPG private key (via
                                            actions/setup-java's gpg-private-key)
              MAVEN_GPG_PASSPHRASE        — passphrase for the key

            The release profile is OFF by default so local `mvn install` and CI
            test runs don't try to sign or publish.
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                                <configuration>
                                    <gpgArguments>
                                        <arg>--pinentry-mode</arg>
                                        <arg>loopback</arg>
                                    </gpgArguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!--
                        0.12.0 is the minimum: with Maven 3.10.0 (the ubuntu-latest default),
                        earlier versions leave maven-metadata-local.xml and _remote.repositories
                        in the bundle, and the Portal rejects the deployment with "Bundle has
                        content that does NOT have a .pom file". CI's release-bundle job checks
                        the bundle layout on every push.
                    -->
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.12.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <waitUntil>published</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
